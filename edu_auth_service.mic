    {
      "id": "sym_app_middleware_auth_required_py_AuthMiddlewa_cb0c8d10d9c8",
      "kind": "class",
      "name": "AuthMiddleware",
      "path": "app/middleware/auth_required.py",
      "start_line": 5,
      "end_line": 24,
      "signature": "class AuthMiddleware",
      "summary": "Authentication middleware that protects incoming requests.",
      "calls": [
        "TokenService",
        "verify_jwt",
        "auth_required"
      ],
      "called_by": [
        "app/middleware/auth_required.py::auth_required"
      ],
      "tests": [],
      "evidence": "class AuthMiddleware:\n    \"\"\"Authentication middleware that protects incoming requests.\"\"\"\n\n    def __init__(self, settings: Settings):\n        self.tokens = TokenService(settings)\n\n    def auth_required(self, request: dict) -> dict:\n        \"\"\"Require a valid access token before allowing a request.\n\n        This middleware calls TokenService.verify_jwt and then checks that\n        the token type is access.\n        \"\"\"\n        token_payload = request.get(\"token\")\n        claims = self.tokens.verify_jwt(token_payload)\n\n        if claims.get(\"type\") != \"access\":\n            raise ValueError(\"Access token required\")\n\n        request[\"user_id\"] = claims[\"sub\"]\n        return request"
    },
    {
