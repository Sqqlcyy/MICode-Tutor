      "path": "app/security/rate_limit.py",
      "start_line": 5,
      "end_line": 6,
      "signature": "class RateLimitExceeded",
      "summary": "Raised when a client exceeds the allowed request rate.",
      "calls": [],
      "called_by": [
        "app/security/rate_limit.py::RateLimiter",
        "app/security/rate_limit.py::RateLimiter.check"
      ],
      "tests": [],
      "evidence": "class RateLimitExceeded(ValueError):\n    \"\"\"Raised when a client exceeds the allowed request rate.\"\"\""
    },
    {
      "id": "sym_app_security_rate_limit_py_RateLimiter_26a70d55926b",
      "kind": "class",
      "name": "RateLimiter",
      "path": "app/security/rate_limit.py",
      "start_line": 9,
      "end_line": 32,
      "signature": "class RateLimiter",
      "summary": "Simple in-memory rate limiter for login attempts.",
      "calls": [
        "RateLimitExceeded"
      ],
      "called_by": [
        "app/auth/routes.py::AuthRoutes",
        "app/auth/routes.py::AuthRoutes.__init__"
      ],
      "tests": [],
      "evidence": "class RateLimiter:\n    \"\"\"Simple in-memory rate limiter for login attempts.\"\"\"\n\n    def __init__(self, limit_per_minute: int):\n        self.limit_per_minute = limit_per_minute\n        self.events = defaultdict(deque)\n\n    def check(self, client_id: str) -> None:\n        \"\"\"Check whether a client is allowed to perform another login attempt.\"\"\"\n        now = time.time()\n        window_start = now - 60\n        q = self.events[client_id]\n\n        while q and q[0] < window_start:\n            q.popleft()\n\n        if len(q) >= self.limit_per_minute:\n            raise RateLimitExceeded(\"Too many login attempts\")\n\n        q.append(now)\n\n    def reset(self, client_id: str) -> None:\n        \"\"\"Reset rate limit state for a client.\"\"\"\n        self.events.pop(client_id, None)"
    },
