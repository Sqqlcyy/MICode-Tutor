      "id": "sym_app_auth_password_py_PasswordService_b90a774a6da5",
      "kind": "class",
      "name": "PasswordService",
      "path": "app/auth/password.py",
      "start_line": 6,
      "end_line": 22,
      "signature": "class PasswordService",
      "summary": "Hash and verify passwords with a configurable salt.",
      "calls": [
        "hash_password",
        "verify_password"
      ],
      "called_by": [
        "app/auth/password.py::hash_password",
        "app/auth/password.py::verify_password"
      ],
      "tests": [],
      "evidence": "class PasswordService:\n    \"\"\"Hash and verify passwords with a configurable salt.\"\"\"\n\n    def __init__(self, settings: Settings):\n        self.settings = settings\n\n    def hash_password(self, password: str) -> str:\n        \"\"\"Hash a password for storage.\"\"\"\n        if not password:\n            raise ValueError(\"Password cannot be empty\")\n        raw = f\"{self.settings.password_salt}:{password}\".encode(\"utf-8\")\n        return hashlib.sha256(raw).hexdigest()\n\n    def verify_password(self, password: str, password_hash: str) -> bool:\n        \"\"\"Verify a password against a stored hash.\"\"\"\n        candidate = self.hash_password(password)\n        return hmac.compare_digest(candidate, password_hash)"
    },
