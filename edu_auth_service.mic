      "name": "create_app",
      "path": "app/main.py",
      "start_line": 7,
      "end_line": 21,
      "signature": "def create_app()",
      "summary": "Create the application and register auth routes.",
      "calls": [
        "Settings.from_env",
        "login",
        "refresh",
        "build_user_store"
      ],
      "called_by": [],
      "tests": [],
      "evidence": "def create_app():\n    \"\"\"Create the application and register auth routes.\"\"\"\n    settings = Settings.from_env()\n    user_store = build_user_store()\n\n    app = {\n        \"settings\": settings,\n        \"user_store\": user_store,\n        \"routes\": {\n            \"/auth/login\": lambda username, password: login(username, password, user_store, settings),\n            \"/auth/refresh\": lambda payload: refresh(payload, settings),\n        },\n        \"middleware\": [auth_required],\n    }\n    return app"
    },
